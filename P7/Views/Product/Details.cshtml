@model P7.Models.Product
@using System.Globalization

@{
    ViewBag.Title = "Product Details - " + Model.Name;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title</title>
    <style>
        .product-image {
            width: 100%;
            max-width: 350px;
            height: 250px;
            object-fit: cover;
            border-radius: 6px;
            border: 1px solid #ddd;
            display: block;
            margin-bottom: 20px;
        }
        
    </style>
</head>
<body>
    <div class="container">
        <h1>Product Details</h1>

        <img src="@Model.ImageUrl" alt="@Model.Name" class="product-image" />

        <table>
            <tr>
                <th>Product ID</th>
                <td>@Model.Id</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>@Model.Name</td>
            </tr>
            <tr>
                <th>Category</th>
                <td>@Model.Category</td>
            </tr>
            <tr>
                <th>Price</th>
                <td>@Model.Price.ToString("C0", CultureInfo.GetCultureInfo("en-IN"))</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>@Model.Description</td>
            </tr>
        </table>

        <a href="@Url.Action("Index", "Product")" class="btn-back">&larr; Back to Product Catalog</a>
    </div>
</body>
</html>
